# Google Analytics measurement ID — leave unset until the owner provides one.
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Resend API key for the contact form's admin notification email.
# Get this from https://resend.com/api-keys — the sending domain
